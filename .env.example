# Copy to .env and fill in. The service-account key file itself must live OUTSIDE
# this repo; only its path goes here.

# Path to the Google Cloud service-account JSON key with Vertex AI access.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/your/service-account-key.json

# Your Google Cloud project id (not a secret, but read from env so it is not hardcoded).
GCP_PROJECT=your-gcp-project-id

# Vertex AI locations. Generation works in "global"; embeddings in "us-central1".
VERTEX_GEN_LOCATION=global
VERTEX_EMBED_LOCATION=us-central1

# Models (defaults are the ones this project was built and tested against).
MODEL_FAST=gemini-2.5-flash
MODEL_PRO=gemini-2.5-pro
MODEL_EMBED=text-multilingual-embedding-002

# Storage paths (defaults point inside data/). Override only if you move them.
# TRADE_DB_PATH=data/trade.sqlite
# VECTORS_PATH=data/vectors.npz
# CHUNKS_PATH=data/chunks.json

# Retrieval tuning.
RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SCORE=0.55

# Vertex list prices, USD per 1,000,000 tokens (override if pricing changes).
PRICE_FLASH_IN=0.30
PRICE_FLASH_OUT=2.50
PRICE_PRO_IN=1.25
PRICE_PRO_OUT=10.00
PRICE_EMBED_IN=0.20
